# =============================================================================
# Qvoke ERP & Billing System — Environment Configuration (.env)
# =============================================================================

# Application Name
VITE_APP_NAME="Qvoke"

# Primary Web & API Server Port
PORT=3000
VITE_PORT=3000

# Dedicated Superadmin Platform Management Port (Optional / Distinct from PORT)
ADMIN_PORT=3001
VITE_ADMIN_PORT=3001

# Application Environment ('development' or 'production')
NODE_ENV=development

# SQLite Database File Path
DB_PATH=quotes.db

# Password Hashing Security (Bcrypt Rounds)
BCRYPT_ROUNDS=12

# JWT / Session Expiry (Days)
SESSION_EXPIRY_DAYS=30

# AI Assistant Integration (Gemini, OpenRouter, or OpenAI API Key)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Default Brand Accent Color
VITE_BRAND_COLOR="#01696f"
